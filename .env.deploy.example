# Copia este archivo como .env.deploy (está en .gitignore) y rellena los valores.
# Nunca subas valores reales al repositorio.
#
# Despliegue automático: .github/workflows/deploy.yml despliega cada push a main.
# Lee este mismo contenido desde el secret DEPLOY_ENV del repositorio (pega ahí
# el .env.deploy completo) y la clave privada desde el secret VM_SSH_KEY; en ese
# caso SSH_KEY se ignora.
#
# Despliegue manual (necesita Docker local): ./scripts/deploy.sh
# El script despliega la rama actual si ya existe en origin. También puedes forzar otra con:
# GIT_REF=main ./scripts/deploy.sh

# Conexión SSH a la VM de producción (Google Cloud, kontrol-staging-jfm / us-central1-a)
VM_IP=35.202.118.162
VM_USER=           # usuario de la VM con la clave autorizada y en el grupo docker (ej: kontrol)
SSH_KEY=~/.ssh/id_rsa  # ruta a tu clave SSH privada (solo despliegue manual)

# Base de datos
# Postgres solo la lee al crear su volumen: cambiarla después no cambia la de
# la base. Genera una con: openssl rand -base64 24
POSTGRES_PASSWORD=
# Vacío = MongoDB local de la VM (contenedor mongo). Solo para usar otro cluster.
MONGODB_URI=

# JWT — cadena larga y aleatoria: openssl rand -hex 32
JWT_SECRET=
JWT_EXPIRES_IN=8h

# Google OAuth — opcional; sin él, el inicio de sesión con Google queda deshabilitado.
# Google Cloud Console → APIs & Services → Credentials → OAuth 2.0 Client IDs
# (tipo "Web application"). Esta URL debe estar en "Authorized redirect URIs".
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_CALLBACK_URL=https://kontrol.it.com/api/auth/google/callback

# Frontend
# Usa HTTPS real en producción si quieres que videollamadas/cámara funcionen en navegador.
FRONTEND_URL=https://kontrol.it.com
# Opcional: si no lo defines, deploy.sh lo deriva desde FRONTEND_URL.
# Caddy saca el certificado para este host; el DNS debe apuntar a VM_IP.
PUBLIC_HOST=kontrol.it.com

# Archivos: adjuntos del chat y evidencias (imágenes, video, audio, documentos).
# Consola de Cloudinary → Settings → API Keys. El cloud name aparece arriba de
# esa página y en el Dashboard; no es el nombre de la API key.
# Sin estas tres variables no se pueden subir archivos.
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Agente de IA (Kontrol AI) — opcional. Sin AGENT_API_KEY el agente queda
# deshabilitado. Vacíos = valores por defecto de backend/.env.example.
AGENT_API_URL=
AGENT_API_KEY=
AGENT_MODEL=
AGENT_TEMPERATURE=
AGENT_MAX_TOKENS=
AGENT_MAX_STEPS=
AGENT_DISABLE_THINKING=

# Pagos (PAY-1) — solo claves de MODO DE PRUEBA de Stripe (sk_test_...).
# El backend rechaza claves de producción. Vacío = pagos deshabilitados y todas
# las empresas en el plan gratuito.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# Opcional: solo si quieres forzar URLs explícitas o TURN en el build del frontend
VITE_API_URL=
VITE_SOCKET_URL=
VITE_WEBRTC_ICE_SERVERS=
