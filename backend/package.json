{
  "name": "@control/backend",
  "version": "1.0.0",
  "private": true,
  "license": "UNLICENSED",
  "type": "module",
  "engines": {
    "node": ">=20 <23"
  },
  "scripts": {
    "dev": "cross-env NODE_ENV=development node --dns-result-order=ipv4first --watch src/index.js",
    "start": "node --dns-result-order=ipv4first src/index.js",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "test:integration": "cross-env TEST_SUITE=integration vitest run -c vitest.integration.config.js tests/integration",
    "test:regression": "cross-env TEST_SUITE=regression vitest run -c vitest.integration.config.js tests/regression",
    "test:integration:report": "node scripts/integration-report.js",
    "db:test:up": "docker compose -f ../docker-compose.integration.yml up -d --wait",
    "db:test:down": "docker compose -f ../docker-compose.integration.yml down",
    "seed:test": "node src/db/seed.js",
    "reset:test": "node src/db/reset.js",
    "stripe:seed": "node scripts/stripe-seed.js",
    "verify:ux-phase2": "node src/db/verifyUxPhase2.js",
    "test:privacy": "vitest run -c vitest.privacy.config.js",
    "validate:privacy": "npm run test:coverage && npm run test:integration && npm run test:regression && npm run test:privacy"
  },
  "devDependencies": {
    "@vitest/coverage-v8": "^4.1.10",
    "cross-env": "^7.0.3",
    "supertest": "^7.2.2",
    "vitest": "^4.1.10"
  },
  "dependencies": {
    "bcrypt": "^6.0.0",
    "cors": "^2.8.5",
    "dotenv": "^16.4.0",
    "express": "^4.21.0",
    "express-rate-limit": "^8.7.0",
    "google-auth-library": "^10.6.2",
    "helmet": "^8.3.0",
    "jsonwebtoken": "^9.0.3",
    "mongoose": "^9.5.0",
    "pg": "^8.20.0",
    "socket.io": "^4.8.3",
    "socket.io-client": "^4.8.3",
    "stripe": "^23.0.0",
    "zod": "^4.6.7"
  }
}
