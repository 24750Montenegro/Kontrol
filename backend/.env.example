PORT=3000

# PostgreSQL local (Docker Compose)
# When running via docker-compose, the host is "postgres" (service name)
# When running the backend directly without Docker, use "localhost"
DATABASE_URL=postgresql://postgres:postgres@postgres:5432/kontrol

# Set to "true" only if connecting to a remote DB that requires SSL (e.g. Supabase)
# The server certificate is always verified (DT-15); any sslmode in DATABASE_URL is ignored.
DATABASE_SSL=false
# CA to verify the DB certificate when it is not a public one (Supabase uses its own).
# Either a file path or the inline PEM with "\n" escapes. Empty = system CAs.
DATABASE_SSL_CA=

# PostgreSQL pool (DT-15). All optional; the defaults below apply when unset.
# Max clients in the pool
DB_POOL_MAX=10
# How long a query waits for a free client before failing (ms)
DB_POOL_CONNECTION_TIMEOUT_MS=5000
# How long an idle client stays open before being closed (ms)
DB_POOL_IDLE_TIMEOUT_MS=10000
# Log total/idle/waiting pool counters every N ms (e.g. during k6 runs). 0 or empty = off.
# The same counters are always available in GET /api/health under "db".
DB_POOL_STATS_INTERVAL_MS=

# JWT
JWT_SECRET=change_this_to_a_strong_random_secret
JWT_EXPIRES_IN=8h

# Google OAuth
# Create credentials at: https://console.cloud.google.com → APIs & Services → Credentials
# Add http://localhost:3000/api/auth/google/callback to "Authorized redirect URIs"
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_CALLBACK_URL=http://localhost:3000/api/auth/google/callback

# Frontend URL (used to redirect after OAuth callback)
FRONTEND_URL=http://localhost:5173

# MongoDB (for chat)
# When running via docker-compose, the host is "mongo" (service name)
MONGODB_URI=mongodb://mongo:27017/kontrol_chat?replicaSet=rs0

# Integrations — used to encrypt stored API keys and webhook URLs
# Must be a long random string. If omitted, falls back to JWT_SECRET.
INTEGRATION_ENCRYPTION_KEY=
# Timeout for outgoing integration HTTP calls (DT-15). Optional, default 10000.
INTEGRATION_HTTP_TIMEOUT_MS=10000

# Cloudinary (chat attachments and task evidence: images, video, audio, documents).
# From the Cloudinary console → Settings → API Keys: the cloud name is shown at
# the top of that page. The browser uploads straight to Cloudinary with a
# signature issued by the backend; the secret never leaves the server.
# Leave empty to disable uploads.
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Rate limiting (DT-13). All optional; the defaults below apply when unset.
# Set RATE_LIMIT_ENABLED=false only for load tests that must not be throttled.
RATE_LIMIT_ENABLED=true
# Requests per IP to /api/auth/* every 15 min
RATE_LIMIT_AUTH_MAX=100
# Login attempts per IP every 15 min (successful or not)
RATE_LIMIT_LOGIN_IP_MAX=30
# Failed login attempts per account every 15 min
RATE_LIMIT_LOGIN_ACCOUNT_MAX=5
# Failed account deletion attempts per IP every 15 min
RATE_LIMIT_ACCOUNT_DELETE_IP_MAX=30
# Failed account deletion attempts per account every 15 min
RATE_LIMIT_ACCOUNT_DELETE_USER_MAX=5
# Company exports per user and company every 15 min
RATE_LIMIT_COMPANY_EXPORT_MAX=3
# Requests per user per minute to the expensive endpoints from SCRUM-28
RATE_LIMIT_EXPENSIVE_MAX=60


# Billing / subscriptions (PAY-1) — TEST MODE ONLY.
# Stripe does not operate in Guatemala: Kontrol uses it only to demonstrate the
# flow and never charges real cards. The server refuses keys that do not start
# with sk_test_ / rk_test_ and events with livemode=true. Never commit values.
# Leave empty to disable billing: every company stays on the Free plan.
BILLING_PROVIDER=stripe
STRIPE_SECRET_KEY=
# Signing secret of the webhook endpoint (/api/billing/webhook). Locally it is
# printed by: stripe listen --forward-to localhost:3000/api/billing/webhook
STRIPE_WEBHOOK_SECRET=


# AI Agent (Kontrol AI)
# Optional override. If omitted, Kontrol uses https://model.clawstitch.com/v1
# and appends "/chat/completions" automatically.
AGENT_API_URL=
AGENT_API_KEY=
AGENT_MODEL=Qwen/Qwen3.6-27B-FP8
AGENT_TEMPERATURE=0.2
# Qwen 3.6 is a reasoning model — give it headroom for the thinking phase plus the JSON turn.
AGENT_MAX_TOKENS=4096
AGENT_MAX_STEPS=5
AGENT_DISABLE_THINKING=false

# Logging: debug | info | warn | error | silent (default: info in production, debug otherwise)
LOG_LEVEL=info

# Privacy P1: transactions require Mongo replica set (Atlas already supports it).
# Local Docker Mongo accessed from the host:
# MONGODB_URI=mongodb://127.0.0.1:27017/kontrol_chat?replicaSet=rs0&directConnection=true
COMPANY_EXPORT_TIMEOUT_MS=900000
RATE_LIMIT_COMPANY_EXPORT_MAX=3
RATE_LIMIT_ACCOUNT_DELETE_IP_MAX=30
RATE_LIMIT_ACCOUNT_DELETE_USER_MAX=5
